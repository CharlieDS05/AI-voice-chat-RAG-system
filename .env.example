# Which LLM backend to use: "local" (Ollama) or "hosted" (OpenAI-compatible API)
LLM_PROVIDER=local

# Local provider (Ollama, runs on your machine)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# Hosted provider (any OpenAI-compatible API) 
# We'll pick the actual vendor on Day 5; these are placeholders.
HOSTED_BASE_URL=https://api.groq.com/openai/v1
HOSTED_MODEL=llama-3.3-70b-versatile
HOSTED_API_KEY=

# Evaluation judge (falls back to the generation provider if unset)

JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MIN_CHUNK_CHARS=50

# Embeddings & vector store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=chroma_db
COLLECTION_NAME=documents

# Hybrid retrieval
RETRIEVAL_K=10
RRF_K=60
HYBRID_TOP_N=10

# Reranking
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=8

# Generation
TEMPERATURE=0.0
MAX_ANSWER_TOKENS=512
PROMPT_FILE=prompts/rag_system.yaml

# Answerability gate
REFUSAL_THRESHOLD=-5.0

# Voice (Apple Silicon native only)
WHISPER_MODEL=mlx-community/whisper-base-mlx
PIPER_VOICE=models/voices/en_US-lessac-medium.onnx

# Server
SERVER_NAME=127.0.0.1

# Hugging Face Hub
# 0 = allow downloads (required on first run)
# 1 = offline: use cached models only. Set after your first successful run.
HF_OFFLINE=1

#   API
# Empty disables auth (fine for local dev). Set a long random value in production.
API_KEY=
RATE_LIMIT=10/minute
API_PORT=8000

FASTEMBED_CACHE=models/fastembed

# Demo mode (public deployments)
DEMO_MODE=false
DEMO_CORPUS_NAME=NIST AI Risk Management Framework (AI RMF 1.0)
DEMO_CORPUS_ATTRIBUTION=NIST AI 100-1 · U.S. National Institute of Standards and Technology · public domain
DEMO_EXAMPLES=What are the four core functions of the AI RMF?|What makes an AI system trustworthy?|What does the GOVERN function cover?|How do I configure a Kubernetes cluster? (watch it decline)