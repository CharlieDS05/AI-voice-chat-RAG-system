# Which LLM backend to use: "local" (Ollama) or "hosted" (OpenAI-compatible API)
LLM_PROVIDER=local

# Local provider (Ollama, runs on your machine)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# --- Hosted provider (any OpenAI-compatible API) ---
# We'll pick the actual vendor on Day 5; these are placeholders.
HOSTED_BASE_URL=https://api.openai.com/v1
HOSTED_MODEL=gpt-4o-mini
HOSTED_API_KEY=your_key_here

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150