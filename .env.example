# Which LLM backend to use: "local" (Ollama) or "hosted" (OpenAI-compatible API)
LLM_PROVIDER=local

# Local provider (Ollama, runs on your machine)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# --- Hosted provider (any OpenAI-compatible API) ---
# We'll pick the actual vendor on Day 5; these are placeholders.
HOSTED_BASE_URL=https://api.openai.com/v1
HOSTED_MODEL=gpt-4o-mini
HOSTED_API_KEY=your_key_here

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MIN_CHUNK_CHARS=50

# Embeddings & vector store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=chroma_db
COLLECTION_NAME=documents

# Hybrid retrieval
RETRIEVAL_K=10
RRF_K=60
HYBRID_TOP_N=10

# Reranking
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=4

# Generation
TEMPERATURE=0.0
MAX_ANSWER_TOKENS=512
PROMPT_FILE=prompts/rag_system.yaml

# Answerability gate
REFUSAL_THRESHOLD=-5.0
# Voice
WHISPER_MODEL=mlx-community/whisper-base-mlx
PIPER_VOICE=models/voices/en_US-lessac-medium.onnx